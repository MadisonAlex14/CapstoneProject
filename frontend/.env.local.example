# Supabase Configuration (Required)
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Test User Credentials (Optional, for authentication tests)
# If you want to run tests that require login
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123

# Test API Token (Optional, for API-level testing)
# If you need an access token for API calls
TEST_API_TOKEN=your_test_token_here
